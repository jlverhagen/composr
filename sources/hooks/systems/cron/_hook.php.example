/**
 * Hook class (example for system scheduler/cron hooks).
 *
 * This is an example template showing the available methods for hooks in this directory.
 * Copy this file to a new file named after your hook (e.g. my_hook.php) and implement the methods.
 */
class Hook_cron_example
{
    /**
     * Get info from this hook.
     *
     * Optional: However most cron hooks should implement this to describe schedule and queue count.
     *
     * @param  ?TIME $last_run Last time run (null: never)
     * @param  ?boolean $calculate_num_queued Calculate the number of items queued, if possible (null: the hook may decide / low priority)
     * @return ?array Return a map of info about the hook (null: disabled)
     */
    public function info(?int $last_run, ?bool $calculate_num_queued) : ?array
    {
        return [
            'label' => 'Example task',
            'num_queued' => null, // Optional to calculate
            'minutes_between_runs' => 60,
            'enabled_by_default' => true,
        ];
    }

    /**
     * Run function for system scheduler hooks. Searches for tasks to perform.
     *
     * Required.
     *
     * @param  ?TIME $last_run Last time run (null: never). Optional parameter; some core hooks omit it.
     * @return void
     */
    public function run(?int $last_run = null)
    {
        // Implement your scheduled task here
    }
}
