/**
 * Hook class (example for config option hooks).
 *
 * Copy this file to a new file named after your config option and implement the methods.
 */
class Hook_config_example
{
    /**
     * Gets the details relating to the config option.
     *
     * Required.
     *
     * @return array The details
     */
    public function get_details() : array
    {
        return [
            'human_name' => 'EXAMPLE_OPTION',
            'type' => 'line',
            'category' => 'GENERAL',
            'group' => 'GENERAL',
            'explanation' => 'CONFIG_OPTION_example',
            'shared_hosting_restricted' => '0',
            'list_options' => '',
            'required' => false,
            'public' => false,
            'addon' => 'ADDON_NAME_HERE',
        ];
    }

    /**
     * Gets the default value for the config option.
     *
     * Required.
     *
     * @return ?string The default value (null: option is disabled)
     */
    public function get_default() : ?string
    {
        return '';
    }
}
