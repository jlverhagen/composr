escription";s:466:"Makes a post in the specified forum, in the specified topic according to the given specifications. If the topic doesn't exist, it is created along with a spacer-post.Spacer posts exist in order to allow staff to delete the first true post in a topic. Without spacers, this would not be possible with most forum systems. They also serve to provide meta information on the topic that cannot be encoded in the title (such as a link to the content being commented upon).";s:5:"flags";a:0:{}s:9:"is_static";b:0;s:11:"is_abstract";b:0;s:8:"is_final";b:0;s:10:"visibility";s:6:"public";s:6:"return";a:2:{s:4:"type";s:5:"array";s:11:"description";s:63:"Topic ID (may be null), and whether a hidden post has been made";}}s:21:"get_forum_topic_posts";a:12:{s:8:"filename";s:22:"sources/forum/ipb3.php";s:10:"parameters";a:6:{i:0;a:8:{s:4:"name";s:8:"topic_id";s:8:"php_type";s:3:"int";s:17:"php_type_nullable";b:0;s:3:"ref";b:0;s:11:"is_variadic";b:0;s:4:"type";s:7:"integer";s:11:"description";s:12:"The topic ID";s:11:"phpdoc_name";s:8:"topic_id";}i:1;a:10:{s:4:"name";s:5:"count";s:8:"php_type";s:3:"int";s:17:"php_type_nullable";b:1;s:3:"ref";b:1;s:11:"is_variadic";b:0;s:7:"default";N;s:11:"default_raw";s:5:" null";s:4:"type";s:8:"?integer";s:11:"description";s:77:"The comment count will be returned here by reference (null: do not gather it)";s:11:"phpdoc_name";s:5:"count";}i:2;a:10:{s:4:"name";s:3:"max";s:8:"php_type";s:3:"int";s:17:"php_type_nullable";b:1;s:3:"ref";b:0;s:11:"is_variadic";b:0;s:7:"default";i:100;s:11:"default_raw";s:4:" 100";s:4:"type";s:8:"?integer";s:11:"description";s:45:"Maximum comments to returned (null: no limit)";s:11:"phpdoc_name";s:3:"max";}i:3;a:10:{s:4:"name";s:5:"start";s:8:"php_type";s:3:"int";s:17:"php_type_nullable";b:0;s:3:"ref";b:0;s:11:"is_variadic";b:0;s:7:"default";i:0;s:11:"default_raw";s:2:" 0";s:4:"type";s:7:"integer";s:11:"description";s:19:"Comment to start at";s:11:"phpdoc_name";s:5:"start";}i:4;a:10:{s:4:"name";s:9:"mark_read